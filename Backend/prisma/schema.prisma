datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Client Inquiries & Commercial Proposals
model Inquiry {
  id            String    @id @default(uuid())
  inquiryCode   String    @unique
  client        String
  project       String
  amount        Float
  contactPerson String?
  email         String?
  phone         String?
  date          DateTime  @default(now())
  status        String    // "Inquiry Received", "Offer Sent", "Confirmed", "Unconfirmed"
  holdStatus    Boolean   @default(false)
  holdReason    String?
  heldAt        DateTime?
  remarks       String?
  startDate     DateTime?
  estimatedDuration Int?      // Duration in days
  projectLead   String?
  weeksAgo      Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders        Order[]
  wbsTasks      WBSTask[]
  teamMembers   ProjectTeam[]
  jobs          Job[]
  runningJobs   RunningJob[]
}

// 2. Confirmed Orders & Manufacturing Jobs
model Order {
  id           String            @id @default(uuid())
  orderNumber  String            @unique
  inquiryId    String?
  inquiry      Inquiry?          @relation(fields: [inquiryId], references: [id])
  clientName   String
  projectName  String
  panels       String            // Comma separated or JSON string
  priority     String            // "High", "Medium", "Low"
  currentStage String            // e.g. "Mechanical Dept."
  progress     Int               @default(0)
  startDate    DateTime
  deadline     DateTime
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  phaseRemarks    PhaseRemark[]
  phaseChecklists PhaseChecklist[]
  materials       MaterialRequest[]
}

// 3. Work Breakdown Structure (WBS) Phases & Tasks
model WBSPhase {
  id        String    @id @default(uuid())
  wbsCode   String    @unique
  name      String
  badge     String
  owner     String
  tasks     WBSTask[]
}

model WBSTask {
  id          String   @id @default(uuid())
  wbsCode     String
  name        String
  phaseId     String
  phase       WBSPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  inquiryId   String?
  inquiry     Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  owner       String
  planHours   Float
  actualHours Float    @default(0)
  status      String   // "DONE", "IN PROGRESS", "NOT STARTED"
  progress    Int      @default(0)
  blockers    String?  // Text area for tracking issues/blockers
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments WBSTaskAssignment[]
}

// 4. Production Phase Department Checklists & Remarks
model PhaseRemark {
  id        String   @id @default(uuid())
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  phaseId   String   // e.g. "assembly"
  remark    String
  updatedAt DateTime @updatedAt
}

model PhaseChecklist {
  id        String   @id @default(uuid())
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  phaseId   String   // e.g. "design", "mechanical", "assembly"
  taskId    Int
  taskName  String
  completed Boolean  @default(false)
}

// 5. Staff & Employee Directory (With Microsoft OAuth SSO support)
model Employee {
  id           String   @id @default(uuid())
  empCode      String   @unique
  name         String
  email        String   @unique
  passwordHash String
  department   String
  designation  String
  role         String
  isAdmin      Boolean  @default(false)
  permissions  String   @default("{}")
  status       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attendances        Attendance[]
  projectTeams       ProjectTeam[]
  taskAssignments    WBSTaskAssignment[]
  visitReports       VisitReport[]
  leaveApplications  LeaveApplication[]
  runningJobs        RunningJob[]
  salarySlips        SalarySlip[]
}

model Attendance {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime @default(now())
  clockIn     String?
  clockOut    String?
  status      String   // "Present", "Late", "On Leave"
}

// 6. Material Requisitions & Inventory
model MaterialRequest {
  id            String   @id @default(uuid())
  requestCode   String   @unique
  orderId       String?
  order         Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  itemName      String
  quantity      Int
  requestedBy   String
  requestedDate DateTime @default(now())
  status        String   // "Pending", "Approved", "Rejected"
}

// 7. Project Teams and Resource Allocation
model ProjectTeam {
  id          String   @id @default(uuid())
  inquiryId   String
  inquiry     Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role        String   // "Program Manager", "Project Lead", "Department Lead", "Member"
  department  String?  // e.g. "Mechanical", "Design", "Electrical" (null for Project-Wide roles)
  assignedAt  DateTime @default(now())
  assignedBy  String?  // Admin/Manager ID who assigned them

  @@unique([inquiryId, employeeId, department])
}


// 8. Excel-based Store Inventory Management Models
model Job {
  id          String       @id @default(uuid())
  jobNo       String       @unique // "JOB-01", "JOB-02"
  clientName  String?
  location    String?
  startDate   DateTime?    @default(now())
  status      String       @default("Running") // "Running", "Completed", "On Hold"
  inquiryId   String?      
  inquiry     Inquiry?     @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  stockIssues StockIssue[]
}

model StockItem {
  id            String         @id @default(uuid())
  itemCode      String         @unique // "MCB-006", "CONT-001"
  description   String
  make          String?        // "Schneider Electric", "Siemens"
  partNo        String?
  category      String         // "Switchgear Parts", "Cable", etc.
  unit          String         @default("Nos") // "Nos", "Mtr", "Kg"
  openingStock  Float          @default(0)
  minStockLevel Float          @default(0)
  unitRate      Float          @default(0)
  status        String         @default("Active") // "Active", "Inactive"
  locationRack  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  stockReceipts StockReceipt[]
  stockIssues   StockIssue[]
}

model StockReceipt {
  id         String    @id @default(uuid())
  receiptNo  String    @unique // "GRN-001"
  date       DateTime  @default(now())
  itemCode   String
  stockItem  StockItem @relation(fields: [itemCode], references: [itemCode], onDelete: Cascade)
  qtyIn      Float
  supplier   String?
  invoiceNo  String?
  receivedBy String?
  remarks    String?
  createdAt  DateTime  @default(now())
}

model StockIssue {
  id        String    @id @default(uuid())
  issueNo   String    @unique // "ISS-001"
  date      DateTime  @default(now())
  jobNo     String
  job       Job       @relation(fields: [jobNo], references: [jobNo], onDelete: Cascade)
  itemCode  String
  stockItem StockItem @relation(fields: [itemCode], references: [itemCode], onDelete: Cascade)
  qtyOut    Float
  issuedTo  String?
  issuedBy  String?
  remarks   String?
  createdAt DateTime  @default(now())
}

// 9. Employee Hub & ERP Models
model WBSTaskAssignment {
  id          String   @id @default(uuid())
  wbsTaskId   String
  wbsTask     WBSTask  @relation(fields: [wbsTaskId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedAt  DateTime @default(now())

  @@unique([wbsTaskId, employeeId])
}

model VisitReport {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  clientName  String
  location    String
  purpose     String
  visitDate   DateTime @default(now())
  remarks     String?
  createdAt   DateTime @default(now())
}

model LeaveApplication {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    String   // "Full Day", "Half Day - AM", "Half Day - PM"
  fromDate     DateTime
  toDate       DateTime
  halfDayTime  String?
  reason       String
  status       String   @default("Pending") // "Pending", "Approved", "Rejected"
  routedToRole String   @default("HR")
  createdAt    DateTime @default(now())
}

model RunningJob {
  id          String    @id @default(uuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  inquiryId   String?
  inquiry     Inquiry?  @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  description String
  progress    Int       @default(0)
  startDate   DateTime  @default(now())
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
}

model SalarySlip {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month       String
  year        Int
  basicSalary Float
  allowances  Float    @default(0)
  deductions  Float    @default(0)
  netSalary   Float
  createdAt   DateTime @default(now())

  @@unique([employeeId, month, year])
}


