generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Inquiry {
  id                String        @id @default(uuid())
  inquiryCode       String        @unique
  client            String
  project           String
  amount            Float
  contactPerson     String?
  email             String?
  phone             String?
  date              DateTime      @default(now())
  status            String
  holdStatus        Boolean       @default(false)
  holdReason        String?
  heldAt            DateTime?
  remarks           String?
  startDate         DateTime?
  estimatedDuration Int?
  projectLead       String?
  weeksAgo          Int           @default(1)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  jobs              Job[]
  orders            Order[]
  teamMembers       ProjectTeam[]
  runningJobs       RunningJob[]
  wbsTasks          WBSTask[]
}

model Order {
  id              String            @id @default(uuid())
  orderNumber     String            @unique
  inquiryId       String?
  clientName      String
  projectName     String
  panels          String
  priority        String
  currentStage    String
  progress        Int               @default(0)
  startDate       DateTime
  deadline        DateTime
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  materials       MaterialRequest[]
  inquiry         Inquiry?          @relation(fields: [inquiryId], references: [id])
  phaseChecklists PhaseChecklist[]
  phaseRemarks    PhaseRemark[]
}

model WBSPhase {
  id      String    @id @default(uuid())
  wbsCode String    @unique
  name    String
  badge   String
  owner   String
  tasks   WBSTask[]
}

model WBSTask {
  id          String              @id @default(uuid())
  wbsCode     String
  name        String
  phaseId     String
  inquiryId   String?
  owner       String
  planHours   Float
  actualHours Float               @default(0)
  status      String
  progress    Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  blockers    String?
  errorFlag   String?
  notes       String?
  inquiry     Inquiry?            @relation(fields: [inquiryId], references: [id])
  phase       WBSPhase            @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  assignments WBSTaskAssignment[]
}

model PhaseRemark {
  id        String   @id @default(uuid())
  orderId   String?
  phaseId   String
  remark    String
  updatedAt DateTime @updatedAt
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PhaseChecklist {
  id        String  @id @default(uuid())
  orderId   String?
  phaseId   String
  taskId    Int
  taskName  String
  completed Boolean @default(false)
  order     Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Employee {
  id                    String              @id @default(uuid())
  empCode               String              @unique
  name                  String
  email                 String              @unique
  passwordHash          String              @default("")
  googleId              String?             @unique
  avatarUrl             String?
  department            String
  designation           String
  role                  String
  isAdmin               Boolean             @default(false)
  permissions           String              @default("{}")
  status                String
  casualLeaveBalance    Int                 @default(12)
  sickLeaveBalance      Int                 @default(8)
  privilegeLeaveBalance Int                 @default(15)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  attendances           Attendance[]
  leaveApplications     LeaveApplication[]
  projectTeams          ProjectTeam[]
  runningJobs           RunningJob[]
  salarySlips           SalarySlip[]
  visitReports          VisitReport[]
  taskAssignments       WBSTaskAssignment[]
}

model Attendance {
  id         String   @id @default(uuid())
  employeeId String
  date       DateTime @default(now())
  clockIn    String?
  clockOut   String?
  status     String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model MaterialRequest {
  id            String   @id @default(uuid())
  requestCode   String   @unique
  orderId       String?
  itemName      String
  quantity      Int
  requestedBy   String
  requestedDate DateTime @default(now())
  status        String
  order         Order?   @relation(fields: [orderId], references: [id])
}

model ProjectTeam {
  id         String   @id @default(uuid())
  inquiryId  String
  employeeId String
  role       String
  assignedAt DateTime @default(now())
  assignedBy String?
  department String?
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  inquiry    Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@unique([inquiryId, employeeId, department])
}

model Job {
  id          String       @id @default(uuid())
  jobNo       String       @unique
  clientName  String?
  location    String?
  startDate   DateTime?    @default(now())
  status      String       @default("Running")
  inquiryId   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  inquiry     Inquiry?     @relation(fields: [inquiryId], references: [id])
  stockIssues StockIssue[]
}

model StockItem {
  id            String         @id @default(uuid())
  itemCode      String         @unique
  description   String
  make          String?
  partNo        String?
  category      String
  unit          String         @default("Nos")
  openingStock  Float          @default(0)
  minStockLevel Float          @default(0)
  unitRate      Float          @default(0)
  status        String         @default("Active")
  locationRack  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  stockIssues   StockIssue[]
  stockReceipts StockReceipt[]
}

model StockReceipt {
  id         String    @id @default(uuid())
  receiptNo  String    @unique
  date       DateTime  @default(now())
  itemCode   String
  qtyIn      Float
  supplier   String?
  invoiceNo  String?
  receivedBy String?
  remarks    String?
  createdAt  DateTime  @default(now())
  stockItem  StockItem @relation(fields: [itemCode], references: [itemCode], onDelete: Cascade)
}

model StockIssue {
  id        String    @id @default(uuid())
  issueNo   String    @unique
  date      DateTime  @default(now())
  jobNo     String
  itemCode  String
  qtyOut    Float
  issuedTo  String?
  issuedBy  String?
  remarks   String?
  createdAt DateTime  @default(now())
  stockItem StockItem @relation(fields: [itemCode], references: [itemCode], onDelete: Cascade)
  job       Job       @relation(fields: [jobNo], references: [jobNo], onDelete: Cascade)
}

model WBSTaskAssignment {
  id         String   @id @default(uuid())
  wbsTaskId  String
  employeeId String
  assignedAt DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  wbsTask    WBSTask  @relation(fields: [wbsTaskId], references: [id], onDelete: Cascade)

  @@unique([wbsTaskId, employeeId])
}

model VisitReport {
  id         String   @id @default(uuid())
  employeeId String
  clientName String
  location   String
  purpose    String
  visitDate  DateTime @default(now())
  remarks    String?
  createdAt  DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model LeaveApplication {
  id           String   @id @default(uuid())
  employeeId   String
  leaveType    String
  fromDate     DateTime
  toDate       DateTime
  halfDayTime  String?
  reason       String
  status       String   @default("Pending")
  routedToRole String   @default("HR")
  createdAt    DateTime @default(now())
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model RunningJob {
  id          String    @id @default(uuid())
  employeeId  String
  inquiryId   String?
  description String
  progress    Int       @default(0)
  startDate   DateTime  @default(now())
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  inquiry     Inquiry?  @relation(fields: [inquiryId], references: [id])
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model SalarySlip {
  id          String   @id @default(uuid())
  employeeId  String
  month       String
  year        Int
  basicSalary Float
  allowances  Float    @default(0)
  deductions  Float    @default(0)
  netSalary   Float
  createdAt   DateTime @default(now())
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
}

model ApprovalRequest {
  id          String    @id @default(uuid())
  googleId    String    @unique
  email       String
  name        String
  avatarUrl   String?
  status      String    @default("Pending")
  permissions String    @default("{}")
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?
}
