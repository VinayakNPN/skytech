datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Client Inquiries & Commercial Proposals
model Inquiry {
  id                String    @id @default(uuid())
  inquiryCode       String    @unique
  client            String
  project           String
  amount            Float
  contactPerson     String?
  email             String?
  phone             String?
  date              DateTime  @default(now())
  status            String // "Inquiry Received", "Offer Sent", "Confirmed", "Unconfirmed"
  holdStatus        Boolean   @default(false)
  holdReason        String?
  heldAt            DateTime?
  remarks           String?
  startDate         DateTime?
  estimatedDuration Int? // Duration in days
  projectLead       String?
  weeksAgo          Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  orders      Order[]
  wbsTasks    WBSTask[]
  teamMembers ProjectTeam[]
}

// 2. Confirmed Orders & Manufacturing Jobs
model Order {
  id           String   @id @default(uuid())
  orderNumber  String   @unique
  inquiryId    String?
  inquiry      Inquiry? @relation(fields: [inquiryId], references: [id])
  clientName   String
  projectName  String
  panels       String // Comma separated or JSON string
  priority     String // "High", "Medium", "Low"
  currentStage String // e.g. "Mechanical Dept."
  progress     Int      @default(0)
  startDate    DateTime
  deadline     DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  phaseRemarks    PhaseRemark[]
  phaseChecklists PhaseChecklist[]
  materials       MaterialRequest[]
}

// 3. Work Breakdown Structure (WBS) Phases & Tasks
model WBSPhase {
  id      String    @id @default(uuid())
  wbsCode String    @unique
  name    String
  badge   String
  owner   String
  tasks   WBSTask[]
}

model WBSTask {
  id          String   @id @default(uuid())
  wbsCode     String
  name        String
  phaseId     String
  phase       WBSPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  inquiryId   String?
  inquiry     Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  owner       String
  planHours   Float
  actualHours Float    @default(0)
  status      String // "DONE", "IN PROGRESS", "NOT STARTED"
  progress    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 4. Production Phase Department Checklists & Remarks
model PhaseRemark {
  id        String   @id @default(uuid())
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  phaseId   String // e.g. "assembly"
  remark    String
  updatedAt DateTime @updatedAt
}

model PhaseChecklist {
  id        String  @id @default(uuid())
  orderId   String?
  order     Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  phaseId   String // e.g. "design", "mechanical", "assembly"
  taskId    Int
  taskName  String
  completed Boolean @default(false)
}

// 5. Staff & Employee Directory (With Microsoft OAuth SSO support)
model Employee {
  id           String   @id @default(uuid())
  empCode      String   @unique
  name         String
  email        String   @unique
  passwordHash String
  department   String
  designation  String
  role         String
  isAdmin      Boolean  @default(false)
  permissions  String   @default("{}")
  status       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attendances  Attendance[]
  projectTeams ProjectTeam[]
}

model Attendance {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime @default(now())
  clockIn    String?
  clockOut   String?
  status     String // "Present", "Late", "On Leave"
}

// 6. Material Requisitions & Inventory
model MaterialRequest {
  id            String   @id @default(uuid())
  requestCode   String   @unique
  orderId       String?
  order         Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  itemName      String
  quantity      Int
  requestedBy   String
  requestedDate DateTime @default(now())
  status        String // "Pending", "Approved", "Rejected"
}

// 7. Project Teams and Resource Allocation
model ProjectTeam {
  id         String   @id @default(uuid())
  inquiryId  String
  inquiry    Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role       String // "Lead", "Member"
  assignedAt DateTime @default(now())
  assignedBy String? // Admin/Manager ID who assigned them

  @@unique([inquiryId, employeeId])
}
