# Application Configuration
PORT=5000
NODE_ENV=development

# Database Settings (PostgreSQL via Neon / Supabase)
DATABASE_URL="postgresql://username:password@localhost:5432/spms_db?schema=public"

# Security Configurations
JWT_SECRET="spms_super_secret_jwt_token_development_only_12345"
JWT_EXPIRES_IN="8h"

# Core ERP Service Placeholders (For future use)
# MS_ENTRA_TENANT_ID=your_tenant_id
# MS_ENTRA_CLIENT_ID=your_client_id
# MS_ENTRA_CLIENT_SECRET=your_client_secret
